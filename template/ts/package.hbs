{
  "name": "{{github.name}}",
  "description": "{{project.title}}",
  "version": "{{project.version}}",
  "author": {
    "name": "{{author.name}}",
    "url": "{{author.url}}"
  },
  "keywords": [
  {{#with project}}
  {{#listJoin "," keywords}} "{{this}}" {{/listJoin}}
  {{/with}}
  ],
  "license": "{{license}}",
  "homepage": "https://github.com/{{github.account}}/{{github.name}}",
  "repository": {
    "type": "git",
    "url": "https://github.com/{{github.account}}/{{github.name}}.git"
  },
  "bugs": "https://github.com/{{github.account}}/{{github.name}}/issues"
  {{#ifSatisfy "equals" implementation.tags "cli"}}
   , "bin": {
    "{{github.name}}": "dist/src/cli.mjs"
  },
    "type": "module",
    "exports": {
      ".": {
        "import": "./dist/src/cli.mjs",
        "default": "./dist/src/cli.mjs",
        "types": "./dist/src"
      },
      "./package.json": {
        "default": "./package.json"
      }
    },
    "main": "./dist/src/index.mjs",
    "files": [
      "dist/src",
      "src"
    ],
    "engines": {
      "node": ">=22"
    },
    "scripts": {
      "build": "tsc --outDir dist",
      "test": "node --test --loader ts-node/esm test/*.test.ts",
      "cli": "node --loader ts-node/esm src/cli.mts"
    }
  {{/ifSatisfy}}
  {{#ifSatisfy "equals" implementation.tags "lib"}}
    , "type": "module",
    "types": "./dist/src/index.d.mts",
    "exports": {
      ".": {
        "import": "./dist/src/index.mjs",
        "default": "./dist/src/index.mjs",
        "types": "./dist/src"
      },
      "./package.json": {
        "default": "./package.json"
      }
    },
    "main": "./dist/src/index.mjs",
    "files": [
      "dist/src",
      "src"
    ],
    "bin": {},
    "engines": {
      "node": ">=22"
    },
    "scripts": {
      "build": "tsc --outDir dist",
      "test": "node --test --loader ts-node/esm test/*.test.ts"
    }
  {{/ifSatisfy}}
}
