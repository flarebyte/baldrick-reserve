{
  "name": "{{github.name}}",
  "description": "{{project.title}}",
  "version": "{{project.version}}",
  "author": {
    "name": "{{author.name}}",
    "url": "{{author.url}}"
  },
  "keywords": [
  {{#with project}}
  {{#listJoin "," keywords}} "{{this}}" {{/listJoin}}
  {{/with}}
  ],
  "license": "{{license}}",
  "homepage": "https://github.com/{{github.account}}/{{github.name}}",
  "repository": {
    "type": "git",
    "url": "https://github.com/{{github.account}}/{{github.name}}.git"
  },
  "bugs": "https://github.com/{{github.account}}/{{github.name}}/issues"
  {{#ifSatisfy "equals" implementation.tags "cli"}}
   , "bin": {
    "{{github.name}}": "dist/src/cli.mjs"
  },
    "type": "module",
    "exports": {
      ".": {
        "import": "./dist/cli.mjs",
        "default": "./dist/cli.mjs",
        "types": "./src"
      },
      "./package.json": {
        "default": "./package.json"
      }
    },
    "main": "./dist/index.js",
    "files": [
      "dist",
      "src"
    ],
    "engines": {
      "node": ">=22"
    },
    "scripts": {
      "build": "tsc --outDir dist",
      "test": "tsx --test test/*.test.ts",
      "cli": "tsx src/cli.mts",
      "test:cov": "c8 --reporter=text-summary --reporter=lcov yarn -s test"
    },
    "c8": {
    "all": true,
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "dist/**",
      "test/**",
      "pest-spec/**",
      "spec/**",
      "**/*.d.ts"
    ]
  }
  {{/ifSatisfy}}
  {{#ifSatisfy "equals" implementation.tags "lib"}}
    , "type": "module",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs",
        "types": "./dist"
      },
      "./package.json": {
        "default": "./package.json"
      }
    },
    "main": "./dist/index.mjs",
    "files": [
      "dist",
      "src"
    ],
    "bin": {
      "{{github.name}}": "dist/cli.mjs"
    },
    "engines": {
      "node": ">=22"
    },
    "scripts": {
      "build": "tsc --outDir dist",
      "test": "tsx --test test/*.test.ts",
      "cli": "tsx src/cli.mts",
      "test:cov": "c8 --reporter=text-summary --reporter=lcov yarn -s test"
    },
    "c8": {
    "all": true,
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "dist/**",
      "test/**",
      "pest-spec/**",
      "spec/**",
      "**/*.d.ts"
    ]
  }
  {{/ifSatisfy}}
}
